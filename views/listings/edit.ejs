<% layout("layouts/boilerplate") -%>

  <style>
    .edit-container {
        max-width: 800px;
        margin: 2rem auto;
        padding: 2.5rem;
        background: #fff;
        border: 1px solid #dddddd;
        border-radius: 12px;
        box-shadow: 0 6px 16px rgba(0,0,0,0.12);
    }
    .edit-header {
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 2rem;
        color: #222222;
        border-bottom: 1px solid #ebebeb;
        padding-bottom: 1rem;
    }
    .form-control, .form-select {
        border: 1px solid #b0b0b0;
        padding: 0.8rem 1rem;
        font-size: 1rem;
        border-radius: 8px;
        color: #222222;
    }
    .form-control:focus, .form-select:focus {
        border-color: #222222;
        box-shadow: 0 0 0 1px #222222;
        outline: none;
    }
    .form-label {
        font-weight: 500;
        color: #222222;
        margin-bottom: 0.5rem;
    }
    .btn-airbnb {
        background-color: #FF385C;
        color: white;
        font-weight: 600;
        font-size: 1.1rem;
        padding: 1rem 2rem;
        border-radius: 8px;
        border: none;
        transition: background-color 0.2s;
    }
    .btn-airbnb:hover {
        background-color: #D70466;
        color: white;
    }
    .img-preview {
        border-radius: 12px;
        object-fit: cover;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border: 1px solid #ebebeb;
    }
  </style>

  <body>
    <div class="container">
      <div class="edit-container">
        <h3 class="edit-header">Edit your Listing</h3>
        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation"
          enctype="multipart/form-data">
          
          <div class="mb-4">
            <label for="title" class="form-label">Title</label>
            <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" required />
          </div>
          
          <div class="mb-4">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" rows="4" required><%= listing.description %></textarea>
          </div>
          
          <div class="mb-4">
            <p class="form-label mb-2">Original Image</p>
            <img class="img-preview" height="250px" width="100%" style="max-width: 400px;" src="<%= originalImage %>" alt="Original Listing Image" />
          </div>
          
          <div class="mb-4">
            <label for="image" class="form-label">Upload New Image</label>
            <input name="listing[image]" id="image" type="file" class="form-control" />
            <input type="hidden" name="originalImage" value="<%= originalImage %>" />
          </div>
          
          <div class="row">
            <div class="mb-4 col-md-4">
              <label for="price" class="form-label">Price</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0" style="border: 1px solid #b0b0b0; border-radius: 8px 0 0 8px; font-weight: 500;">&#8377;</span>
                <input name="listing[price]" value="<%= listing.price %>" type="number" class="form-control border-start-0" style="border-radius: 0 8px 8px 0;" required />
              </div>
            </div>
            <div class="mb-4 col-md-8">
              <label for="country" class="form-label">Country</label>
              <input name="listing[country]" value="<%= listing.country %>" type="text" class="form-control" required />
            </div>
          </div>
          
          <div class="mb-5">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" value="<%= listing.location %>" type="text" class="form-control" required />
          </div>
          
          <button class="btn btn-airbnb w-100">Save Changes</button>
        </form>
      </div>
    </div>

    <script>
      // JavaScript to handle image input change
      document.getElementById('image').addEventListener('input', function () {
        const originalImageInput = document.querySelector('input[name="originalImage"]');
        if (this.value.trim() === '') {
          this.value = originalImageInput.value;
        }
      });
    </script>
  </body>