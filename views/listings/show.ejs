<% layout("/layouts/boilerplate.ejs") %>

<style>
    .listing-title {
        font-size: 1.8rem;
        font-weight: 600;
        color: #222222;
        margin-bottom: 0.2rem;
    }
    .listing-subtitle {
        font-size: 1rem;
        font-weight: 500;
        color: #222222;
        text-decoration: underline;
        margin-bottom: 1.5rem;
    }
    .listing-hero-img {
        width: 100%;
        max-height: 60vh;
        object-fit: cover;
        border-radius: 16px;
        margin-bottom: 2rem;
    }
    .host-info {
        font-size: 1.3rem;
        font-weight: 600;
        color: #222222;
    }
    .listing-description {
        font-size: 1.05rem;
        color: #222222;
        line-height: 1.6;
    }
    .booking-card {
        border: 1px solid #dddddd;
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 6px 16px rgba(0,0,0,0.12);
        background: #ffffff;
        position: sticky;
        top: 100px;
    }
    .price-text {
        font-size: 1.4rem;
        font-weight: 600;
        color: #222222;
    }
    .night-text {
        font-size: 1rem;
        font-weight: 400;
        color: #717171;
    }
    .btn-reserve {
        background-color: #FF385C;
        color: white;
        font-weight: 600;
        font-size: 1.1rem;
        padding: 0.8rem;
        border-radius: 8px;
        border: none;
        width: 100%;
        transition: background-color 0.2s;
    }
    .btn-reserve:hover {
        background-color: #D70466;
        color: white;
    }
    .btn-edit {
        background-color: #ffffff;
        color: #222222;
        border: 1px solid #222222;
        font-weight: 600;
        font-size: 1.1rem;
        padding: 0.8rem;
        border-radius: 8px;
        width: 100%;
        transition: background-color 0.2s;
    }
    .btn-edit:hover {
        background-color: #f7f7f7;
    }
    .review-card {
        border: 1px solid #dddddd !important;
        border-radius: 12px !important;
        padding: 1.5rem !important;
        margin-bottom: 1rem;
    }
    .review-author {
        font-weight: 600;
        font-size: 1.1rem;
        color: #222222;
        margin-bottom: 0.2rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .author-avatar {
        width: 40px;
        height: 40px;
        background-color: #dddddd;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: #ffffff;
    }
    .review-comment {
        font-size: 1rem;
        color: #222222;
        line-height: 1.5;
    }
    .form-control:focus {
        border-color: #222222;
        box-shadow: 0 0 0 1px #222222;
        outline: none;
    }
    hr {
        border-top: 1px solid #dddddd;
        margin: 2rem 0;
        opacity: 1;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-12 col-xl-10 offset-xl-1">
            
            <!-- Title and Location -->
            <h1 class="listing-title"><%= listing.title %></h1>
            <div class="listing-subtitle">
                <i class="fa-solid fa-location-dot me-1"></i> <%= listing.location %>, <%= listing.country %>
            </div>

            <!-- Hero Image -->
            <img src="<%= listing.image.url %>" class="listing-hero-img" alt="listing-img">

            <div class="row">
                <!-- Left Column: Details & Reviews -->
                <div class="col-md-7 col-lg-8 pr-md-4">
                    <div class="host-info mb-2">
                        Entire <%= listing.category ? listing.category.toLowerCase() : 'place' %> hosted by <%= listing.owner.username %>
                    </div>
                    
                    <hr>
                    
                    <div class="listing-description">
                        <%= listing.description %>
                    </div>
                    
                    <hr>

                    <!-- Reviews Section -->
                    <div class="reviews-section">
                        <% if(currUser){ %>
                            <h4 class="fw-semibold mb-4">Leave a Review</h4>
                            <form novalidate class="needs-validation" action="/listings/<%= listing._id %>/reviews" method="POST">
                                <div class="mb-3">
                                    <label class="form-label fw-medium text-dark" for="rating">Rating</label>
                                    <fieldset class="starability-slot">
                                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                        <label for="first-rate1" title="Terrible">1 star</label>
                                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                        <label for="first-rate2" title="Not good">2 stars</label>
                                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                        <label for="first-rate3" title="Average">3 stars</label>
                                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                        <label for="first-rate4" title="Very good">4 stars</label>
                                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                        <label for="first-rate5" title="Amazing">5 stars</label>
                                    </fieldset>
                                </div>
                                <div class="mb-4">
                                    <label for="comment" class="form-label fw-medium text-dark">Comment</label>
                                    <textarea required name="review[comment]" class="form-control rounded-3" id="comment" rows="4" placeholder="Share your experience..."></textarea>
                                    <div class="invalid-feedback">Please add some comments for your review.</div>
                                </div>
                                <button class="btn btn-dark fw-semibold px-4 py-2 rounded-3">Submit Review</button>
                            </form>
                            <hr>
                        <% } %>
                        
                        <% if(listing.reviews.length){ %>
                            <h4 class="fw-semibold mb-4"><i class="fa-solid fa-star me-2"></i>Reviews</h4>
                            <div class="row">
                                <% for (review of listing.reviews){%>
                                    <div class="col-md-6 mb-3">
                                        <div class="card review-card h-100">
                                            <div class="card-body p-0">
                                                <div class="review-author">
                                                    <div class="author-avatar">
                                                        <i class="fa-solid fa-user"></i>
                                                    </div>
                                                    <%= review.author.username %>
                                                </div>
                                                <p class="starability-result mt-2 mb-2" data-rating="<%= review.rating %>">
                                                    Rated: <%= review.rating %> stars
                                                </p>
                                                <p class="review-comment"><%= review.comment %></p>
                                                
                                                <% if(currUser && review.author._id.equals(currUser._id)){ %>
                                                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-3">
                                                        <button class="btn btn-sm text-decoration-underline text-dark p-0 border-0 bg-transparent fw-semibold">Delete Review</button>
                                                    </form>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                <% }%>
                            </div>
                        <% } else { %>
                            <p class="text-muted fs-5">No reviews yet. Be the first to review this place!</p>
                        <% }%>
                    </div>
                </div>

                <!-- Right Column: Booking/Action Card -->
                <div class="col-md-5 col-lg-4 mt-4 mt-md-0">
                    <div class="booking-card">
                        <div class="mb-4">
                            <span class="price-text">&#8377; <%= listing.price.toLocaleString("en-IN") %></span>
                            <span class="night-text">night</span>
                        </div>

                        <% if(currUser && currUser._id.equals(listing.owner._id)){ %>
                            <div class="d-flex flex-column gap-3">
                                <a href="/listings/<%= listing._id%>/edit" class="text-decoration-none">
                                    <button class="btn-edit">Edit Listing</button>
                                </a>
                                <form action="/listings/<%= listing._id%>?_method=DELETE" method="POST" class="m-0">
                                    <button class="btn-reserve">Delete Listing</button>
                                </form>
                            </div>
                        <% } else { %>
                            <button class="btn-reserve">Reserve</button>
                            <div class="text-center mt-3 text-muted" style="font-size: 0.9rem;">You won't be charged yet</div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
   